    "express": "^5.2.0",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "retry-request": "^8.0.2",
    "teeny-request": "^10.1.2",
