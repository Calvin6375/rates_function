rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is admin using Custom Claims
    // SECURITY: Uses Firebase Auth Custom Claims, not Firestore field
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // Helper function to check if request modifies balance field
    function modifiesBalance() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['balance', 'fiatBalance', 'cryptoBalance']);
    }
    
    // Users collection - authenticated users can read all (for dashboard functionality)
    match /users/{userId} {
      // Allow authenticated users to read all user documents (for dashboard)
      allow read: if isAuthenticated();
      
      // Users can create their own document (e.g. after sign-up) at users/{theirUid}
      allow create: if isOwner(userId);
      
      // Users can update their own document EXCEPT balance fields
      // Balance can only be modified by Cloud Functions (server-side) or admins
      allow update: if isOwner(userId) && !modifiesBalance();
      
      // Admins can create/update any user document including balance
      allow create, update: if isAdmin();
      
      // Server SDK (Cloud Functions) can create/update
      allow create, update: if request.auth == null; // null auth = server SDK
      
      // Users cannot delete their own documents, only admins
      allow delete: if isAdmin();
    }
    
    // Transactions collection - users can read their own transactions
    match /transactions/{transactionId} {
      // Users can read their own transactions
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      // Only Cloud Functions can write transactions (server SDK bypasses rules)
      allow write: if false; // Client writes blocked, server SDK bypasses rules
    }
    
    // Admin logs collection - admin read only
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      // Only Cloud Functions can write admin logs (server SDK bypasses rules)
      allow write: if false; // Client writes blocked, server SDK bypasses rules
    }
    
    // P2P rates collection - public read, admin write
    match /p2pRates/{document=**} {
      allow read: if true; // Public read access for rates
      // Only admins or Cloud Functions can write rates
      allow write: if isAdmin() || request.auth == null; // null auth = server SDK
    }
    
    // Config collection - public read for fees, admin write
    match /config/{document=**} {
      allow read: if true; // Public read access for fee config
      // Only admins or Cloud Functions can write config
      allow write: if isAdmin() || request.auth == null; // null auth = server SDK
    }
    
    // Orders collection - users can read their own orders
    match /orders/{orderId} {
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      // Only Cloud Functions can write orders (server SDK bypasses rules)
      allow write: if false; // Client writes blocked, server SDK bypasses rules
    }
    
    // Invoice mappings collection - only Cloud Functions can access
    match /invoiceMappings/{invoiceId} {
      // Only Cloud Functions can read/write invoice mappings
      allow read, write: if request.auth == null; // null auth = server SDK
    }
    
    // Payments collection - only Cloud Functions can access
    match /payments/{paymentId} {
      // Only Cloud Functions can read/write payment records
      allow read, write: if request.auth == null; // null auth = server SDK
    }
    
    // Customer wallets collection - authenticated users can read all (for dashboard)
    match /customerWallets/{walletId} {
      // Allow authenticated users to read all wallets (for dashboard functionality)
      allow read: if isAuthenticated();
      // Only admins or Cloud Functions can write
      allow write: if isAdmin() || request.auth == null; // null auth = server SDK
    }
    
    // Outbox collection - only Cloud Functions can access
    match /outbox/{outboxId} {
      // Only Cloud Functions can read/write outbox
      allow read, write: if request.auth == null; // null auth = server SDK
    }
    
    // Notifications collection - users can read their own notifications, admins can read all
    match /notifications/{notificationId} {
      // Users can read their own notifications or system-wide notifications
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || 
                      resource.data.userId == "system" || 
                      isAdmin());
      
      // Only Cloud Functions can create notifications
      allow create: if request.auth == null; // null auth = server SDK
      
      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']);
      
      // Only Cloud Functions can delete notifications
      allow delete: if request.auth == null; // null auth = server SDK
    }
    
    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
